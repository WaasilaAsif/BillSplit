<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <View
        android:id="@+id/expenseIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_card_16"
        android:backgroundTint="@color/color_neutral_variant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/expenseDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="Dinner at Cafe Luna" />

        <TextView
            android:id="@+id/expensePaidBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="paid by Aisha K." />

    </LinearLayout>

    <TextView
        android:id="@+id/expenseShareInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="13sp"
        tools:text="you owe\n$22.50" />

</LinearLayout>
